datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "gco-go"
  output   = "./gen"
  package  = "db"
}

model Image {
  id           String    @id @default(uuid())
  key          String    @unique
  size         BigInt?
  mimeType     String?
  status       String    @default("local") // local | s3
  hits         BigInt    @default(0) // total observed local misses (origin reads)
  lastAccessAt DateTime?
  migratedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status])
  @@map("images")
}
