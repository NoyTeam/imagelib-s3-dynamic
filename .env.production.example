# Production configuration for docker-compose.yml.
#   cp .env.production.example .env.production   (gitignored; keep it private)
#   docker compose --env-file .env.production up -d --build
#
# DATABASE_URL, REDIS_ADDR, REDIS_PASSWORD, LOCAL_PATH and ADDR are wired by docker-compose.yml.

# compose / host
# Host directory with the images (mounted read-only at /data). Files must be readable by
# IMAGELIB_UID (default 65532); world-readable files (644, dirs 755) work as-is.
HOST_LOCAL_PATH=/srv/images
# Where imagelib listens on the host. Keep 127.0.0.1 behind a local reverse proxy / CDN tunnel.
IMAGELIB_BIND=127.0.0.1:8080
# IMAGELIB_UID=65532
# IMAGELIB_GID=65532
# Use URL-safe passwords (they are embedded in DATABASE_URL), e.g. `openssl rand -hex 24`.
POSTGRES_PASSWORD=change-me
REDIS_PASSWORD=change-me
# Redis memory cap (noeviction: writes fail when full). Size it per README "Sizing":
# ~170 B per S3-resident object + ~100 B per heat entry; leave 2x container headroom for AOF rewrites.
REDIS_MAXMEMORY=2gb

# process
ROLE=all
DB_AUTO_PUSH=true
DB_PUSH_ALLOW_DESTRUCTIVE=false
REDIS_PREFIX=imagelib:

# S3 bucket (Backblaze B2)
# Endpoint and region must match. The bucket must allow public reads at S3_PUBLIC_URL.
# B2: add a lifecycle rule keeping only the latest version (daysFromHidingToDeleting=1),
# otherwise evicted objects keep using storage.
S3_ENDPOINT=https://s3.eu-central-003.backblazeb2.com
S3_REGION=eu-central-003
S3_BUCKET=
# Dedicated prefix for this service. Never change it once objects exist.
S3_PREFIX=imagelib
# Public base URL of the bucket root (B2 friendly URL or your CDN origin), without the prefix.
S3_PUBLIC_URL=https://f003.backblazeb2.com/file/your-bucket
S3_FORCE_PATH_STYLE=false
# Application key with writeFiles + deleteFiles (+ listFiles for orphan reconciliation).
B2_APPLICATION_KEY_ID=
B2_APPLICATION_KEY=

# capacity & migration
S3_CAPACITY=1TiB
MIGRATE_THRESHOLD=3
MIGRATE_HALF_LIFE=6h
MIGRATE_WORKERS=8
MIGRATE_MIN_SIZE=0
MIGRATE_MAX_SIZE=512MiB
MIGRATE_RETRY_BACKOFF=1m
EVICT_MIN_IDLE=1h
EVICT_INTERVAL=1m
EVICT_DELETE_DELAY=30s

# resilience
# Shorter than the dev default: a hung bucket costs at most this before falling back to local.
S3_UPSTREAM_TIMEOUT=3s
S3_BREAKER_THRESHOLD=5
S3_BREAKER_COOLDOWN=30s
REDIS_TIMEOUT=1s
REDIS_LOOKUP_TIMEOUT=100ms
REDIS_BREAKER_THRESHOLD=5
REDIS_BREAKER_COOLDOWN=5s
INDEX_CACHE_TTL=1s
INDEX_CACHE_MAX_KEYS=1000000

# pipeline & self-healing
EVENT_BUFFER=8192
EVENT_FLUSH_INTERVAL=1s
EVENT_STREAM_MAXLEN=100000
LRU_TOUCH_INTERVAL=1s
STATS_FLUSH_INTERVAL=10s
LEADER_TTL=15s
INDEX_CHECK_INTERVAL=10s
RECONCILE_INTERVAL=24h
# Start with "log"; switch to "delete" once the reported orphans look right.
RECONCILE_ORPHANS=log
RECONCILE_ORPHAN_MIN_AGE=1h
