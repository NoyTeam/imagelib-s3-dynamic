ADDR=:8080
# all = proxy + scheduler (scheduler only works while holding leadership) | proxy | scheduler
ROLE=all
# Unique per process; defaults to hostname-pid
INSTANCE_ID=
DATABASE_URL=postgres://postgres:postgres@localhost:5432/imagelib?sslmode=disable
# Apply the embedded schema/schema.gcorm on startup (advisory-locked, safe with many instances)
DB_AUTO_PUSH=true
# Allow drops / lossy type changes during auto push. Enable only for a reviewed rollout.
DB_PUSH_ALLOW_DESTRUCTIVE=false

# Redis
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_PREFIX=imagelib:
# Client dial/read/write timeout (go-redis defaults are 5s + 3 retries)
REDIS_TIMEOUT=1s
# Per-request index lookup timeout; on timeout/error the request is served from local
REDIS_LOOKUP_TIMEOUT=100ms
# Circuit breakers: open after N consecutive failures, probe again after the cooldown (0 disables)
REDIS_BREAKER_THRESHOLD=5
REDIS_BREAKER_COOLDOWN=5s
S3_BREAKER_THRESHOLD=5
S3_BREAKER_COOLDOWN=30s

# Local (source of truth)
LOCAL_PATH=/path/example/

# Bucket (hot tier)
S3_ENDPOINT=https://s3.eu-central-003.backblazeb2.com
S3_REGION=eu-central-003
S3_BUCKET=
S3_PREFIX=
S3_PUBLIC_URL=
S3_FORCE_PATH_STYLE=false
S3_UPSTREAM_TIMEOUT=10s
B2_APPLICATION_KEY_ID=
B2_APPLICATION_KEY=

# Capacity controller: total bytes kept in S3 (supports KiB/MiB/GiB/TiB, KB/MB/GB/TB)
S3_CAPACITY=10GiB
# Admitting a new object may only evict objects idle at least this long (anti-thrash)
EVICT_MIN_IDLE=10m
EVICT_INTERVAL=1m
# Grace period between de-indexing and deleting an evicted object from S3
EVICT_DELETE_DELAY=30s

# Migration: migrate once the decayed origin-hit score reaches MIGRATE_THRESHOLD
MIGRATE_THRESHOLD=3
MIGRATE_HALF_LIFE=1h
MIGRATE_WORKERS=4
MIGRATE_MIN_SIZE=0
MIGRATE_MAX_SIZE=512MiB
MIGRATE_RETRY_BACKOFF=1m

# Event pipeline / scheduler
EVENT_BUFFER=8192
EVENT_STREAM_MAXLEN=100000
LRU_TOUCH_INTERVAL=1s
STATS_FLUSH_INTERVAL=10s
LEADER_TTL=15s
# Leader checks the Redis index still exists and rebuilds it from PG if lost
INDEX_CHECK_INTERVAL=10s
# PG <-> Redis <-> S3 reconciliation (0 disables); first run right after taking leadership
RECONCILE_INTERVAL=1h
# Bucket objects under S3_PREFIX unknown to the index: off | log | delete (delete requires S3_PREFIX)
RECONCILE_ORPHANS=log
RECONCILE_ORPHAN_MIN_AGE=1h
